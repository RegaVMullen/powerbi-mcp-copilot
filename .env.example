# Power BI Azure AD Configuration
POWERBI_CLIENT_ID=your-client-id-here
POWERBI_CLIENT_SECRET=your-client-secret-here
POWERBI_TENANT_ID=your-tenant-id-here

# Power BI Workspace Configuration
POWERBI_WORKSPACE_ID=your-workspace-id-here
POWERBI_REPORT_ID=your-report-id-here
POWERBI_DATASET_ID=your-dataset-id-here

# API Configuration
POWERBI_API_VERSION=v1.0
POWERBI_API_TIMEOUT=30000

# Authentication
AUTH_CERT_PATH=./certs/server.crt
AUTH_KEY_PATH=./certs/server.key

# Environment
NODE_ENV=development
LOG_LEVEL=info
