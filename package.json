{
  "name": "powerbi-mcp-copilot",
  "version": "1.0.0",
  "description": "Power BI Studio MCP server configured for Copilot cloud agent with REST API integration",
  "main": "index.js",
  "scripts": {
    "test": "node tests/powerbi-api.test.js",
    "test:auth": "node tests/auth.test.js",
    "test:perf": "node tests/performance.test.js",
    "demo": "node tests/demo-capabilities.js",
    "dev": "docker-compose up -d",
    "dev:stop": "docker-compose down",
    "lint": "eslint . --ignore-pattern=node_modules",
    "start": "node src/server.js"
  },
  "keywords": [
    "powerbi",
    "mcp",
    "copilot",
    "rest-api",
    "analytics"
  ],
  "author": "RegaVMullen",
  "license": "MIT",
  "dependencies": {
    "axios": "1.6.0",
    "dotenv": "16.3.1",
    "jsonwebtoken": "9.0.2",
    "node-cache": "5.1.2"
  },
  "devDependencies": {
    "eslint": "8.50.0",
    "dotenv-cli": "7.3.0"
  }
}
